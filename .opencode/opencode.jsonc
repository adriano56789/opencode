{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "name": "Ollama",
      "baseURL": "http://localhost:11434/v1",
      "apiKey": "{env:OLLAMA_API_KEY}",
      "models": {
        "deepseek-r1:7b": {
          "name": "DeepSeek R1 7B",
          "limit": { "context": 16384 }
        },
        "qwen2.5:7b-instruct": {
          "name": "Qwen 2.5 7B",
          "limit": { "context": 16384 }
        },
        "qwen2.5:3b-instruct": {
          "name": "Qwen 2.5 3B",
          "limit": { "context": 16384 }
        }
      }
    }
  },
  "permission": {
    "$schema": "https://opencode.ai/permission/allow.json",
    "rules": [
      { "action": "read", "resource": "**", "effect": "allow" },
      { "action": "write", "resource": "**", "effect": "allow" },
      { "action": "edit", "resource": "**", "effect": "allow" },
      { "action": "execute", "resource": "**", "effect": "allow" }
    ]
  },
  "mcp": {
    "servers": {
      "filesystem": {
        "type": "local",
        "command": "opencode-mcp",
        "args": ["mcp", "filesystem"]
      },
      "ssh": {
        "type": "local",
        "command": "opencode-mcp",
        "args": ["mcp", "ssh"]
      }
    }
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false
  },
  "experimental": {
    "part_rows": true,
  }
}
